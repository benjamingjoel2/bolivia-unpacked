---
import { site, publisher, disclosure } from '../site.config';
import { categories, categoryPath } from '../data/taxonomy';
const year = new Date().getUTCFullYear();
---
<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <p class="f-name">{site.name}</p>
      <p class="published"><a href={publisher.url}>{disclosure.footerPublishedBy}</a></p>
      <p>{disclosure.footerShort}</p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div>
      <h2 class="f-h">Read</h2>
      <ul>
        <li><a href="/blog/">All posts</a></li>
        {categories.map((c) => <li><a href={categoryPath(c.slug)}>{c.name}</a></li>)}
        <li><a href="/rss.xml">RSS feed</a></li>
      </ul>
    </div>
    <div>
      <h2 class="f-h">About</h2>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/authors/">Authors</a></li>
        <li><a href="/disclosure/">Disclosure</a></li>
        <li><a href="/corrections/">Corrections</a></li>
        <li><a href="/photo-credits/">Photo credits</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/cookies/">Cookies</a></li>
        <li><a href="/terms/">Terms</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap legal-line"><p>© {year} Tourground · {site.domain}</p></div>
</footer>
