---
/**
 * Altitude scale running down the side of long pages (desktop only, decorative).
 * Scale 0 m (bottom) to 6,500 m (top). Optional marker for the page's representative elevation.
 */
interface Props { elevation?: number; label?: string }
const { elevation, label } = Astro.props;
const MAX = 6500;
const ticks = [6000, 5000, 4000, 3000, 2000, 1000, 0];
const top = (m: number) => `${((MAX - m) / MAX) * 100}%`;
---
<div class="alt-rail" aria-hidden="true">
  <div class="scale">
    {ticks.map((t) => <span class="tick" style={`top:${top(t)}`}>{t.toLocaleString('en-GB')} m</span>)}
    {elevation !== undefined && (
      <span class="mark" style={`top:${top(elevation)}`}><i></i><b>{label ? `${label} ` : ''}{elevation.toLocaleString('en-GB')} m</b></span>
    )}
    <span class="cap">Altitude scale</span>
  </div>
</div>
