---
import type { Company } from '../lib/feed';
import { countryName, kindLabel, outboundLink } from '../lib/feed';
import TierLabels from './TierLabels.astro';
const { c, pos, headingLevel = 2 } = Astro.props as { c: Company; pos: number; headingLevel?: 2 | 3 };
const link = outboundLink(c);
const H = headingLevel === 3 ? 'h3' : 'h2';
---
<li>
  <span class="pos" aria-label={`Position ${pos}`}>{pos}</span>
  <div>
    <H><a href={`/companies/${c.id}/`}>{c.name}</a></H>
    <p><TierLabels c={c} /></p>
    <p>{c.summary}</p>
    <p class="small muted">{kindLabel(c.kind)} · Based in {countryName(c.country_base)} · Delivers in {c.delivers_in.map(countryName).join(', ')}</p>
    <p class="small"><a href={`/companies/${c.id}/`}>Fact page</a> · <a href={link.href} rel={link.rel}>{link.label}</a>{link.paid && <span class="muted"> (paid link)</span>}</p>
  </div>
</li>
