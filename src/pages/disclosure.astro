---
import Article from '../layouts/Page.astro';
import { site, disclosure } from '../site.config';
---
<Article
  title="Publisher disclosure"
  description="Who publishes Bolivia Unpacked, Tourground's commercial interest, the founder-owned brand we recommend, and how paid placements are labelled."
  path="/disclosure/"
  crumbs={[{ name: 'Home', path: '/' }, { name: 'Publisher disclosure', path: '/disclosure/' }]}
  published={site.launchDate}
  reviewed={site.launchDate}
  sources={[]}
  rail={false}
  kicker="Disclosure"
>
  {disclosure.publisherDisclosure.map((p) => <p>{p}</p>)}
  <h2>Labels you will see</h2>
  <dl class="facts">
    <div><dt>{disclosure.founderOwnedLabel}</dt><dd>{disclosure.founderOwnedExplainer}</dd></div>
    <div><dt>{disclosure.paidLabel}</dt><dd>{disclosure.paidExplainer}</dd></div>
    <div><dt>Verified on Tourground</dt><dd>The operator is listed in the Tourground directory, which publishes only companies it has verified.</dd></div>
  </dl>
</Article>
