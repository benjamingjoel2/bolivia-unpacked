---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist on Bolivia Unpacked. It may have moved. Try the home page or the list of all posts." path="/404/" noindex>
  <div class="wrap page-article">
    <header class="page-head">
      <h1>Page not found</h1>
      <p class="dek">This page does not exist. It may have moved when the site became a blog.</p>
    </header>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/blog/">All posts</a></li>
      <li><a href="/destinations/">Destinations</a></li>
    </ul>
  </div>
</Base>
