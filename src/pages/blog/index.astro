---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts, postPath } from '../../lib/posts';
import { abs, webPageNode } from '../../lib/seo';
const posts = await allPosts();
const title = 'All posts';
const description = 'Every Bolivia Unpacked post, newest first: destinations, itineraries, altitude, adventure, food and culture, and practical travel tips for Bolivia.';
const nodes = [
  webPageNode({ type: 'CollectionPage', path: '/blog/', title, description }),
  { '@type': 'ItemList', itemListElement: posts.map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(postPath(p)), name: p.data.title })) },
];
---
<Base title={title} description={description} path="/blog/" crumbs={[{ name: 'Home', path: '/' }, { name: title, path: '/blog/' }]} nodes={nodes}>
  <div class="wrap">
    <header class="page-head">
      <h1>{title}</h1>
      <p class="dek">{description}</p>
    </header>
    <div class="grid-3">
      {posts.map((p, i) => <PostCard post={p} eager={i < 3} headingLevel={2} />)}
    </div>
  </div>
</Base>
