---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import PlanTrip from '../../components/PlanTrip.astro';
import Sources from '../../components/Sources.astro';
import PostCard from '../../components/PostCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import AdSlot from '../../components/AdSlot.astro';
import { allPosts, postPath, readingMinutes, relatedPosts, humanDate, iso, wordCount, type Post } from '../../lib/posts';
import { categoryBySlug, categoryPath, destinationBySlug, destinationPath } from '../../data/taxonomy';
import { authorById } from '../../data/authors';
import { photo } from '../../lib/photos';
import { abs, blogPostingNode, webPageNode } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await allPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props as { post: Post; all: Post[] };
const d = post.data;
const { Content } = await render(post);
const path = postPath(post);
const cat = categoryBySlug(d.categories[0])!;
const author = authorById(d.author)!;
const hero = photo(d.hero);
const og = await getImage({ src: hero.image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 75 });
const ogUrl = abs(og.src);
const related = relatedPosts(post, all, 3);
const updated = d.updated.getTime() !== d.published.getTime();
const crumbs = [
  { name: 'Home', path: '/' },
  { name: cat.name, path: categoryPath(cat.slug) },
  { name: d.title, path },
];
const nodes = [
  webPageNode({ path, title: d.title, description: d.description, image: ogUrl }),
  blogPostingNode({
    path, title: d.title, description: d.description, published: iso(d.published), modified: iso(d.updated),
    authorName: author.name, authorPath: `/authors/#${author.id}`, image: { url: ogUrl, width: 1200, height: 630 },
    section: cat.name, keywords: [...d.categories.map((c) => categoryBySlug(c)!.name), ...d.destinations.map((x) => destinationBySlug(x)!.name)],
    wordCount: wordCount(post), citations: d.sources.map((s) => s.url),
  }),
];
---
<Base title={d.title} description={d.description} path={path} crumbs={crumbs} nodes={nodes} ogType="article" ogImage={{ url: ogUrl, width: 1200, height: 630, alt: hero.alt }}>
  <meta slot="head" property="article:published_time" content={iso(d.published)} />
  <meta slot="head" property="article:modified_time" content={iso(d.updated)} />
  <article class="post">
    <header class="wrap post-head">
      <p class="kicker"><a href={categoryPath(cat.slug)}>{cat.name}</a></p>
      <h1>{d.title}</h1>
      <p class="dek">{d.description}</p>
      <p class="byline">
        By <a href={`/authors/#${author.id}`}>{author.name}</a>
        <span aria-hidden="true"> · </span><time datetime={iso(d.published)}>{humanDate(d.published)}</time>
        <span aria-hidden="true"> · </span>{readingMinutes(post)} min read
        {updated && <><br />Updated <time datetime={iso(d.updated)}>{humanDate(d.updated)}</time></>}
      </p>
    </header>
    <div class="wrap wide hero">
      <Figure key={d.hero} alt={d.heroAlt} eager sizes="(min-width: 1200px) 1168px, 100vw" widths={[480, 800, 1200, 1600]} />
    </div>
    <div class="wrap">
      <div class="post-body">
        <AdSlot page={post.id} />
        {d.factsChecked && (
          <p class="checked">
            <strong>Last checked {humanDate(d.factsChecked)}.</strong> Health, entry and safety details in this post link to the official source and were checked on that date. Rules change, so check those sources again before you travel. This is general information, not medical or legal advice.
          </p>
        )}
        <div class="prose">
          <Content />
        </div>
        {d.destinations.length > 0 && (
          <p class="tags">More on {d.destinations.map((x, i) => <>{i > 0 && ', '}<a href={destinationPath(x)}>{destinationBySlug(x)!.name}</a></>)}</p>
        )}
        <PlanTrip operatorId={d.operator} note={d.planNote} />
        <Sources sources={d.sources} />
      </div>
    </div>
  </article>
  <section class="wrap related" aria-labelledby="related-h">
    <h2 id="related-h">Related posts</h2>
    <div class="grid-3">
      {related.map((r) => <PostCard post={r} />)}
    </div>
  </section>
  <div class="wrap"><Newsletter id="nl-post" /></div>
</Base>
