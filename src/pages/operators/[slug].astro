---
import Article from '../../layouts/Article.astro';
import CompanyEntry from '../../components/CompanyEntry.astro';
import { nicheLists } from '../../data/niches';
import { companiesForList, feedReviewedDate } from '../../lib/feed';
import { itemListLd } from '../../lib/seo';
import { disclosure, site } from '../../site.config';

export function getStaticPaths() {
  return nicheLists.map((list) => ({ params: { slug: list.slug }, props: { list } }));
}
const { list } = Astro.props;
const items = companiesForList(list);
const path = `/operators/${list.slug}/`;
const guideLinks: Record<string, { href: string; label: string }> = {
  'salt-flats-lipez': { href: '/guide/uyuni-and-sur-lipez/', label: 'The Uyuni salt flats and Sur Lípez' },
  'trekking-climbing': { href: '/guide/cordillera-real/', label: 'The Cordillera Real' },
  amazon: { href: '/guide/amazon-and-rurrenabaque/', label: 'The Amazon around Rurrenabaque' },
  'culture-markets': { href: '/guide/potosi-and-sucre/', label: 'Potosí and Sucre' },
  family: { href: '/guide/typical-routes/', label: 'Typical routes' },
  'overland-peru-chile': { href: '/questions/combine-bolivia-and-peru-in-two-weeks/', label: 'Can I combine Bolivia with Peru in two weeks?' },
  'local-operators': { href: '/guide/', label: 'The Bolivia guide' },
};
const g = guideLinks[list.slug];
---
<Article
  title={list.title}
  description={`${list.intro} Ordered only by directory rank; never paid.`.slice(0, 200)}
  path={path}
  crumbs={[{ name: 'Home', path: '/' }, { name: 'Operators', path: '/operators/' }, { name: list.short, path }]}
  published={site.launchDate}
  reviewed={feedReviewedDate()}
  reviewedLabel="Feed last updated"
  sources={[{ url: 'https://tourground.com', label: 'Tourground directory export (company data feed)' }]}
  kicker="Ranking"
  lede={list.intro}
  noindex={items.length === 0}
  jsonld={items.length ? [itemListLd(list.title, path, items.map((c) => ({ name: c.name, path: `/companies/${c.id}/` })))] : []}
>
  <p class="notice small">{disclosure.rankingStatement} <a href="/how-we-rank/">How we rank</a>.</p>
  {items.length > 0 ? (
    <ol class="ranked">
      {items.map((c, i) => <CompanyEntry c={c} pos={i + 1} />)}
    </ol>
  ) : (
    <p><strong>No verified companies are listed for this type of trip yet.</strong> We publish only companies the Tourground directory has verified, and we do not pad lists. In the meantime, the guide covers this topic.</p>
  )}
  <p class="small muted">{items.length} {items.length === 1 ? 'company' : 'companies'} in this list, computed from the current feed.</p>
  {g && <p>Planning reading: <a href={g.href}>{g.label}</a>.</p>}
  <h2>Other lists</h2>
  <ul>{nicheLists.filter((l) => l.slug !== list.slug).map((l) => <li><a href={`/operators/${l.slug}/`}>{l.title}</a></li>)}</ul>
</Article>
