---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Newsletter from '../components/Newsletter.astro';
import AdSlot from '../components/AdSlot.astro';
import { site } from '../site.config';
import { allPosts, postPath, readingMinutes } from '../lib/posts';
import { categories, categoryPath, destinations, destinationPath } from '../data/taxonomy';
import { abs, webPageNode } from '../lib/seo';

const posts = await allPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const startOrder = ['travel-tips', 'altitude-health', 'itineraries'];
const rank = (c: string) => (startOrder.indexOf(c) + 1 || 99);
const startHere = posts.filter((p) => p.data.startHere).sort((a, b) => rank(a.data.categories[0]) - rank(b.data.categories[0])).slice(0, 4);
const latest = posts.filter((p) => p !== featured).slice(0, 6);
const desc = site.positioning;
const nodes = [
  webPageNode({ type: 'CollectionPage', path: '/', title: site.name, description: desc }),
  {
    '@type': 'Blog',
    '@id': `${site.url}/#blog`,
    name: site.name,
    url: abs('/'),
    description: desc,
    publisher: { '@id': `${site.url}/#publisher` },
    blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: abs(postPath(p)), datePublished: p.data.published.toISOString().slice(0, 10) })),
  },
];
---
<Base title={site.name} description={desc} path="/" nodes={nodes}>
  <div class="wrap">
    <h1 class="visually-hidden">{site.name}: {site.tagline}</h1>
    <AdSlot page="home" />
    {featured && (
      <section class="featured" aria-labelledby="featured-h">
        <h2 id="featured-h" class="section-label">Featured story</h2>
        <PostCard post={featured} size="lead" eager headingLevel={3} />
      </section>
    )}

    {startHere.length > 0 && (
      <section class="start-here" aria-labelledby="start-h">
        <div class="start-intro">
          <h2 id="start-h">Start here</h2>
          <p>First time in Bolivia? Read these first: how the country fits together, how to handle the altitude and how long you need.</p>
        </div>
        <ol class="start-list">
          {startHere.map((p, i) => (
            <li><span class="n">{i + 1}</span><a href={postPath(p)}>{p.data.title}</a><span class="m">{readingMinutes(p)} min read</span></li>
          ))}
        </ol>
      </section>
    )}

    <section aria-labelledby="latest-h">
      <div class="section-head">
        <h2 id="latest-h">Latest posts</h2>
        <a href="/blog/">All posts</a>
      </div>
      <div class="grid-3">
        {latest.map((p) => <PostCard post={p} />)}
      </div>
    </section>

    <section class="topics" aria-labelledby="topics-h">
      <h2 id="topics-h">Browse by topic</h2>
      <div class="topic-cols">
        <div>
          <h3><a href="/destinations/">Destinations</a></h3>
          <ul class="topic-list">
            {destinations.map((d) => <li><a href={destinationPath(d.slug)}>{d.name}</a></li>)}
          </ul>
        </div>
        <div>
          <h3>Planning</h3>
          <ul class="topic-list">
            {categories.filter((c) => c.slug !== 'destinations').map((c) => <li><a href={categoryPath(c.slug)}>{c.name}</a><span>{c.description}</span></li>)}
          </ul>
        </div>
      </div>
    </section>

    <Newsletter id="nl-home" />
  </div>
</Base>
