---
import Article from '../../layouts/Article.astro';
import { qaPages } from '../../lib/content';
import { faqLd } from '../../lib/seo';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await qaPages();
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry, others: pages.filter((p) => p.id !== entry.id) } }));
}
const { entry, others } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/questions/${entry.id}/`;
---
<Article
  title={d.title}
  h1={d.question}
  description={d.description}
  path={path}
  crumbs={[{ name: 'Home', path: '/' }, { name: 'Questions', path: '/questions/' }, { name: d.title, path }]}
  published={d.published}
  reviewed={d.reviewed}
  sources={d.sources}
  kicker="Question"
  jsonld={[faqLd([{ q: d.question, a: d.short_answer }])]}
>
  <div class="short-answer">
    <p class="kicker">Short answer</p>
    <p>{d.short_answer}</p>
  </div>
  <Content />
  <Fragment slot="after">
    {others.length > 0 && (
      <section>
        <h2>Other questions</h2>
        <ul>{others.map((o) => <li><a href={`/questions/${o.id}/`}>{o.data.question}</a></li>)}</ul>
      </section>
    )}
  </Fragment>
</Article>
