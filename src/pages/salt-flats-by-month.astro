---
import Article from '../layouts/Article.astro';
import data from '../data/salar-months.json';
const word: Record<string, string> = { high: 'Likely', mid: 'Possible', low: 'Unlikely' };
const access: Record<string, string> = { high: 'Usually open', mid: 'Often restricted', low: 'Often closed' };
---
<Article
  title="Salar de Uyuni and Lípez by month"
  h1="The salt flats, month by month"
  description="Month-by-month guide to the Salar de Uyuni and Sur Lípez: chance of the mirror effect, access to the lagoons, night cold and road conditions."
  path="/salt-flats-by-month/"
  crumbs={[{ name: 'Home', path: '/' }, { name: 'Salt flats by month', path: '/salt-flats-by-month/' }]}
  published={data.published}
  reviewed={data.reviewed}
  sources={data.sources}
  kicker="Signature reference"
  lede="What to expect on the Salar de Uyuni and in Sur Lípez in each month of the year: the mirror, access to the lagoons, the cold and the roads."
  elevation={3656}
  elevationLabel="Salar"
  wide
>
  <p class="notice small">{data.note}</p>
  <div class="table-wrap">
    <table class="month-grid">
      <thead>
        <tr>
          <th scope="col">Month</th>
          <th scope="col">Season</th>
          <th scope="col">Mirror effect</th>
          <th scope="col">Lípez lagoons access</th>
          <th scope="col">Night cold</th>
          <th scope="col">Roads</th>
        </tr>
      </thead>
      <tbody>
        {data.months.map((r) => (
          <tr>
            <th scope="row">{r.m}</th>
            <td>{r.season}</td>
            <td><span class:list={['rating', r.mirror[0]]}>{word[r.mirror[0]]}</span><br /><span class="small">{r.mirror[1]}</span></td>
            <td><span class:list={['rating', r.lipez[0]]}>{access[r.lipez[0]]}</span><br /><span class="small">{r.lipez[1]}</span></td>
            <td>{r.cold}</td>
            <td>{r.roads}</td>
          </tr>
        ))}
      </tbody>
      <caption>Typical pattern. Ratings are qualitative, not measured probabilities.</caption>
    </table>
  </div>
  <div style="max-width:var(--measure)">
    <h2>Reading the table</h2>
    <ul>
      <li><strong>Mirror effect</strong> needs a thin layer of standing rainwater and a calm day. See <a href="/questions/when-do-the-salt-flats-turn-into-a-mirror/">when do the salt flats turn into a mirror?</a></li>
      <li><strong>Lípez access</strong> means getting across or around the salar to the southern lagoons, Laguna Colorada and the geysers. In the wet season, water on the salar can force route changes.</li>
      <li><strong>Night cold</strong> is at the lodges, which sit at around 4,200 m or higher and are often unheated.</li>
    </ul>
    <p>For the route itself, see <a href="/guide/uyuni-and-sur-lipez/">the Uyuni salt flats and Sur Lípez</a>. For verified operators, see the <a href="/operators/salt-flats-lipez/">salt flats and Lípez ranking</a>.</p>
  </div>
</Article>
