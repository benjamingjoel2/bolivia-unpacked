---
import '@fontsource/newsreader/latin-500.css';
import '@fontsource/newsreader/latin-600.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-400-italic.css';
import '@fontsource/source-sans-3/latin-600.css';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site, analytics } from '../site.config';
import { abs, graph, breadcrumbNode, webPageNode, type Crumb } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  crumbs?: Crumb[];
  /** Extra JSON-LD nodes (Organization, WebSite and BreadcrumbList are always added). */
  nodes?: object[];
  /** Page node type when no BlogPosting is given: WebPage, AboutPage, CollectionPage... */
  pageType?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: { url: string; width: number; height: number; alt: string };
  showCrumbs?: boolean;
}
const { title, description, path, crumbs = [{ name: 'Home', path: '/' }], nodes, pageType = 'WebPage', noindex = false, ogType = 'website', ogImage, showCrumbs = true } = Astro.props;
const fullTitle = path === '/' ? `${site.name}: ${site.tagline}` : `${title} | ${site.name}`;
const canonical = abs(path);
const img = ogImage ?? { url: abs('/og-default.png'), width: 1200, height: 630, alt: `${site.name}: ${site.tagline}` };
const ld = graph([...(nodes ?? [webPageNode({ type: pageType, path, title, description })]), breadcrumbNode(crumbs)]);
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f7f4ee" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS feed`} href="/rss.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={img.url} />
    <meta property="og:image:width" content={String(img.width)} />
    <meta property="og:image:height" content={String(img.height)} />
    <meta property="og:image:alt" content={img.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header path={path} />
    <main id="main" tabindex="-1">
      {showCrumbs && crumbs.length > 1 && <div class="wrap"><Breadcrumbs crumbs={crumbs} /></div>}
      <slot />
    </main>
    <Footer />
    {analytics.vercelWebAnalytics && <Analytics />}
  </body>
</html>
