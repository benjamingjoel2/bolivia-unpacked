---
/**
 * Layout for every factual page: H1, published + last-reviewed dates, sources,
 * breadcrumbs (visible + BreadcrumbList JSON-LD) and the side altitude scale.
 */
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageMeta from '../components/PageMeta.astro';
import Sources from '../components/Sources.astro';
import AltitudeRail from '../components/AltitudeRail.astro';
import AdSlot from '../components/AdSlot.astro';
import { breadcrumbLd, articleLd, type Crumb } from '../lib/seo';
import { iso } from '../lib/content';

interface Props {
  title: string;
  h1?: string;
  description: string;
  path: string;
  crumbs: Crumb[];
  published: Date | string;
  reviewed: Date | string;
  reviewedLabel?: string;
  sources: { url: string; label: string; accessed?: string }[];
  jsonld?: object[];
  kicker?: string;
  lede?: string;
  rail?: boolean;
  elevation?: number;
  elevationLabel?: string;
  noindex?: boolean;
  article?: boolean;
  wide?: boolean;
}
const p = Astro.props;
const rail = p.rail ?? true;
const ld = [
  breadcrumbLd(p.crumbs),
  ...(p.article === false ? [] : [articleLd({ title: p.h1 ?? p.title, description: p.description, path: p.path, published: iso(p.published), modified: iso(p.reviewed) })]),
  ...(p.jsonld ?? []),
];
---
<Base title={p.title} description={p.description} path={p.path} jsonld={ld} noindex={p.noindex}>
  <div class:list={['page', { 'has-rail': rail }]}>
    {rail && <AltitudeRail elevation={p.elevation} label={p.elevationLabel} />}
    <article class="content" style={p.wide ? 'max-width:none' : undefined}>
      <Breadcrumbs crumbs={p.crumbs} />
      <AdSlot page={p.path} />
      {p.kicker && <p class="kicker">{p.kicker}</p>}
      <h1>{p.h1 ?? p.title}</h1>
      {p.lede && <p class="lede">{p.lede}</p>}
      <PageMeta published={p.published} reviewed={p.reviewed} reviewedLabel={p.reviewedLabel} />
      <div class="prose"><slot /></div>
      {p.sources.length > 0 && <Sources sources={p.sources} />}
      <slot name="after" />
    </article>
  </div>
</Base>
