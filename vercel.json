{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/rss.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/guide/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/guide/altitude-and-acclimatisation/",
      "destination": "/blog/altitude-in-la-paz/",
      "permanent": true
    },
    {
      "source": "/guide/amazon-and-rurrenabaque/",
      "destination": "/blog/bolivian-amazon-rurrenabaque/",
      "permanent": true
    },
    {
      "source": "/guide/cordillera-real/",
      "destination": "/destinations/la-paz/",
      "permanent": true
    },
    {
      "source": "/guide/entry-and-health/",
      "destination": "/blog/first-timers-guide-to-bolivia/",
      "permanent": true
    },
    {
      "source": "/guide/getting-around/",
